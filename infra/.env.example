# ============================================
# LEXI-AI - Configurações (Template)
# COPIE PARA .env E PREENCHA OS VALORES
# ============================================

# Ambiente
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=lexi_db
POSTGRES_USER=lexi
POSTGRES_PASSWORD=change_me_please
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change_me_please
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_please
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Hugging Face (obtenha em: https://huggingface.co/settings/tokens)
HF_TOKEN=your_token_here

# API
API_PORT=8000
API_URL=http://localhost:8000

# Frontend
FRONTEND_PORT=8501

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=change_me_please

# Elasticsearch
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# Logs
LOG_LEVEL=DEBUG